#!/usr/bin/env bash
# 检查 Markdown 相对链接；断链退出码 1。
set -uo pipefail

root=${1:-.}
files=0; links=0; broken=0

while IFS= read -r -d '' f; do
  files=$((files+1))
  while IFS= read -r target; do
    case $target in
      http://*|https://*|mailto:*|'#'*|'') continue ;;
    esac
    target=${target%%#*}
    [ -z "$target" ] && continue
    links=$((links+1))
    dir=$(dirname "$f")
    if [ ! -e "$dir/$target" ]; then
      printf 'BROKEN %s -> %s\n' "$f" "$target"
      broken=$((broken+1))
    fi
  done < <(grep -oE '\]\([^)]+\)' "$f" | sed -e 's/^](//' -e 's/)$//')
done < <(find "$root" -type f -name '*.md' -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/vendor/*' -print0)

printf 'files=%d links=%d broken=%d\n' "$files" "$links" "$broken"
[ "$broken" -eq 0 ]
