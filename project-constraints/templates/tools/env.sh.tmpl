#!/usr/bin/env bash
# 输出当前环境与角色。来源：向上找 env；找不到或非法则 ENV=unknown，退出码 1。
set -u

find_env_file() {
  local dir=$PWD
  while :; do
    if [ -f "$dir/env" ]; then printf '%s\n' "$dir/env"; return 0; fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

trim_value() {
  local v=$1
  v=${v%" ${v##*[![:space:]]}"}
  v=${v#" ${v%%[![:space:]]*}"}
  case $v in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  printf '%s' "$v"
}

read_key() {
  local file=$1 key=$2 line k v
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case $line in ''|'#'*) continue ;; esac
    line=${line#export }
    k=${line%%=*}
    [ "$k" = "$key" ] || continue
    v=${line#*=}
    trim_value "$v"
    return 0
  done < "$file"
  printf ''
}

env_file=""
if ! env_file=$(find_env_file); then env_file=""; fi

env_val=""; role_val=""; root_val=""
if [ -n "$env_file" ]; then
  env_val=$(read_key "$env_file" ENV)
  role_val=$(read_key "$env_file" ROLE)
  root_val=$(read_key "$env_file" ROOT)
fi

case $env_val in local|testing|staging|prod) ;; *) env_val=unknown ;; esac
case $role_val in authoring|app|ci) ;; *) role_val=unknown ;; esac

if [ "$env_val" = "unknown" ] || [ "$role_val" = "unknown" ]; then
  printf 'ENV=unknown\nROLE=%s\nROOT=%s\n依据=none\n' "$role_val" "$root_val"
  exit 1
fi

printf 'ENV=%s\nROLE=%s\nROOT=%s\n依据=env\n' "$env_val" "$role_val" "$root_val"
